<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền truy cập mạng để upload bài lên Facebook -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Quyền hiển thị thông báo trên Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Quyền hiển thị Bong bóng nổi (Floating Bubble) trên màn hình -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Quyền chạy dịch vụ nền không bị ngắt -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".Z2FBApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Z2FBPostManager"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Màn hình chính Dashboard -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình Biên tập bài viết -->
        <activity
            android:name=".ui.PostEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn hình Đăng nhập Facebook WebView an toàn -->
        <activity
            android:name=".ui.FacebookLoginActivity"
            android:exported="false" />

        <!-- Điểm tiếp nhận Chia sẻ trực tiếp từ Zalo (Share Intent) -->
        <activity
            android:name=".ui.ShareReceiverActivity"
            android:exported="true"
            android:label="@string/title_share_to_z2fb"
            android:theme="@style/Theme.Z2FBPostManager.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Dịch vụ Lắng nghe Thông báo Zalo ngầm -->
        <service
            android:name=".services.ZaloNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Dịch vụ Bong bóng nổi trên màn hình (Floating Bubble Service) -->
        <service
            android:name=".services.FloatingBubbleService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- File Provider để lưu và chia sẻ file ảnh an toàn -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
