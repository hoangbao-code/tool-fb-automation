<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Tags Header: Room Type + District + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_chip_room_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/primary_container"
                android:textColor="@color/primary"
                android:text="Studio Ban Công"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <TextView
                android:id="@+id/tv_chip_district"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@color/secondary_container"
                android:textColor="@color/secondary"
                android:text="Quận 3"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/status_pending"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/badge_pending_text"
                android:background="@color/badge_pending" />
        </LinearLayout>

        <!-- Price & Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_room_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6.5 Triệu / tháng"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/price_tag" />

            <TextView
                android:id="@+id/tv_post_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="15/09 09:30"
                android:textSize="11sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!-- Source group -->
        <TextView
            android:id="@+id/tv_group_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Nguồn Zalo: Nhóm Đầu Chủ Q3"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <!-- Thumbnail & Content Preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_thumbnail"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                android:background="@color/surface_variant" />

            <TextView
                android:id="@+id/tv_caption_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="SIÊU PHẨM STUDIO BAN CÔNG CỰC ĐẸP TẠI QUẬN 3..."
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/text_primary"
                android:maxLines="4"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Target Groups -->
        <TextView
            android:id="@+id/tv_target_groups_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🎯 Đích đến: 5 Nhóm Facebook BĐS"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/divider" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_post_now"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🚀 Duyệt &amp; Đăng Ngay"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/primary"
                android:padding="0dp" />

            <ImageButton
                android:id="@+id/btn_edit_post"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                app:tint="@color/text_secondary"
                android:contentDescription="Sửa tin" />

            <ImageButton
                android:id="@+id/btn_delete_post"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/accent_red"
                android:contentDescription="Xóa tin" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
